#!/bin/sh
#
# 63-pi-studio-sonic-pi.hook.chroot
#
# Install the prebuilt Sonic Pi (the Pi Studio flagship app). Desktop only,
# arm64 chroot. Extracts the vendored runtime tree to /opt/sonic-pi, installs
# system runtime deps, wires a launcher + .desktop.
#
# Runtime deps from the 5B probe (2026-06-21): system ruby 3.2 + erlang + elixir
# (Tau has NO bundled ERTS), Qt6 GUI stack, audio libs. NO supercollider —
# supersonic statically links scsynth. The packaged tree was proven to boot+play
# from a relocated path before this was written.
#
# Recommends are intentionally KEPT (no --no-install-recommends) so the Qt6
# platform plugins come along — without them the GUI won't start.

set -e

# FLAVOR GATE: studio | desktop | nnp. Read the VALUE, not just the file's
# existence — a third product (NNP) has no FLAVOR of its own under the old
# boolean test and would have run every studio hook on a headless server.
# No file at all = studio, which keeps existing vendor bundles working.
PI_FLAVOR=studio; [ -r /tmp/pi-studio/FLAVOR ] && PI_FLAVOR=$(tr -d "[:space:]" < /tmp/pi-studio/FLAVOR) || true; [ -n "$PI_FLAVOR" ] || PI_FLAVOR=studio
[ "$PI_FLAVOR" = studio ] || { echo "I: [flavor] $PI_FLAVOR build - skipping studio-only hook"; exit 0; }

export DEBIAN_FRONTEND=noninteractive
TARBALL=/tmp/pi-studio/sonic-pi-runtime.tar.gz

if [ ! -f "$TARBALL" ]; then
    echo "WARN: [pi-studio-sonic-pi] no $TARBALL vendored — skipping Sonic Pi"
    exit 0
fi

# Deps locked from ldd of the proven binaries (2026-06-21): GUI links only Qt6
# Core/Gui/Widgets/Network/DBus (system); everything else it needs (X11, mesa GL,
# fontconfig, freetype, harfbuzz, glib, icu, libproxy) is base-desktop. erlang/
# elixir/ruby are NOT base. Recommends KEPT so the Qt xcb platform plugin comes.
echo "I: [pi-studio-sonic-pi] runtime deps (ruby+erlang+elixir + Qt6 + audio; NO supercollider)"
apt-get update
apt-get install -y \
    ruby erlang elixir \
    libqt6core6 libqt6gui6 libqt6widgets6 libqt6network6 libqt6dbus6 \
    libasound2t64 libaubio5

echo "I: [pi-studio-sonic-pi] extracting runtime tree -> /opt/sonic-pi"
mkdir -p /opt/sonic-pi
tar -xzf "$TARBALL" -C /opt/sonic-pi
[ -x /opt/sonic-pi/app/build/gui/sonic-pi ] || { echo "E: [pi-studio-sonic-pi] GUI binary missing after extract" >&2; exit 1; }

# NOTE: no post-extract synth patching. The vendored runtime is now Sonic Pi 5.0.0 FINAL (built from
# ~/Development/sonic-pi-5.0), which ships flute + harmonica synthdefs AND registrations complete. The
# earlier beta3/beta4 runtimes lacked them and needed a surgical merge here; that was removed 2026-08-14
# once the Final tree was vendored. Verify below that the Final synths actually made it in.
for _sd in sonic-pi-flute sonic-pi-harmonica; do
    [ -s "/opt/sonic-pi/etc/synthdefs/compiled/${_sd}.scsyndef" ] \
        || { echo "E: [pi-studio-sonic-pi] ${_sd}.scsyndef missing — wrong runtime (not 5.0.0 Final?)" >&2; exit 1; }
done
grep -q ":harmonica => Harmonica.new" /opt/sonic-pi/app/server/ruby/lib/sonicpi/synths/synthinfo.rb \
    || { echo "E: [pi-studio-sonic-pi] harmonica not registered — wrong runtime (not 5.0.0 Final?)" >&2; exit 1; }
echo "I: [pi-studio-sonic-pi] Sonic Pi 5.0.0 Final: flute + harmonica present + registered"

echo "I: [pi-studio-sonic-pi] launcher /usr/bin/sonic-pi"
# Plain exec — the binary self-resolves its tree. NO theme/colour-theme.properties
# seeding (patch 09 baked ARMED in as default; seeding would clobber other themes).
cat > /usr/bin/sonic-pi <<'EOF'
#!/bin/sh
# The GUI's RUNPATH is an absolute build-host path (/home/.../kissfft-131.1.0)
# that won't exist here. LD_LIBRARY_PATH is searched BEFORE RUNPATH and is
# inherited by child processes (ruby spider, supersonic), so point it at the
# in-/opt tree-local libs.
export LD_LIBRARY_PATH="/opt/sonic-pi/app/build/kissfft-131.1.0${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /opt/sonic-pi/app/build/gui/sonic-pi "$@"
EOF
chmod +x /usr/bin/sonic-pi

echo "I: [pi-studio-sonic-pi] icon + desktop entry"
ICON=$(find /opt/sonic-pi/app/gui -type f \( -iname 'app.png' -o -iname '*icon*.png' \) 2>/dev/null | head -1)
[ -n "$ICON" ] && install -Dm644 "$ICON" /usr/share/icons/hicolor/256x256/apps/sonic-pi.png || \
    echo "WARN: [pi-studio-sonic-pi] no app icon found in tree (entry will use generic)"

cat > /usr/share/applications/sonic-pi.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Sonic Pi
GenericName=Code-based Music Creation
Comment=Live coding music synth — Pi Studio low-latency build
Exec=/usr/bin/sonic-pi
Icon=sonic-pi
Terminal=false
Categories=AudioVideo;Audio;Education;
EOF

echo "I: [pi-studio-sonic-pi] done — /opt/sonic-pi installed, launch 'sonic-pi'"
