#!/bin/sh
#
# 50-wiimplay.hook.chroot
#
# Build and install WiiM Play — a GTK3 UPnP/DLNA control point for WiiM music
# streamers — from source, system-wide. Desktop flavor only (this hook is only
# copied into the live-build config when PROJECT=ubuntu, see build-rootfs.sh).
#
# Upstream: https://github.com/shumatech/wiimplay  (GPLv3, dormant since v0.2)
# Pinned to v0.2 (== upstream main tip == the build validated on hardware).
#
# Runs inside the live-build chroot (native arm64 via qemu) as root.
# Build deps are installed, then purged, so they do not ship in the image
# (runtime dep libgtk-3-0 is already pulled in by ubuntu-desktop-rockchip).

set -e

# FLAVOR GATE: GUI flavours only. An ALLOWLIST on purpose — a new flavour
# defaults to NOT getting desktop payload, which fails safe. Under the old
# ungated form this hook would have installed a browser/GUI stack onto the
# headless NNP server image.
PI_FLAVOR=studio; [ -r /tmp/pi-studio/FLAVOR ] && PI_FLAVOR=$(tr -d "[:space:]" < /tmp/pi-studio/FLAVOR) || true; [ -n "$PI_FLAVOR" ] || PI_FLAVOR=studio
case "$PI_FLAVOR" in
  studio|desktop) ;;
  *) echo "I: [flavor] $PI_FLAVOR build - skipping GUI-only hook"; exit 0 ;;
esac

WIIMPLAY_REPO="https://github.com/shumatech/wiimplay.git"
WIIMPLAY_REF="v0.2"
BUILD_DIR="$(mktemp -d)"

echo "I: [wiimplay] installing build dependencies"
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    golang-go git ca-certificates libgtk-3-dev pkg-config build-essential

echo "I: [wiimplay] cloning ${WIIMPLAY_REF}"
git clone --depth 1 --branch "${WIIMPLAY_REF}" "${WIIMPLAY_REPO}" "${BUILD_DIR}/wiimplay"
cd "${BUILD_DIR}/wiimplay"

echo "I: [wiimplay] building (native arm64, CGO/GTK3)"
# Noble ships go 1.22; module needs 1.21.5. Pin to the local toolchain so go
# does not try to fetch a different one. Stamp version/build like the Makefile,
# minus upx (skipped to avoid an extra build dep — it only compresses).
export GOTOOLCHAIN=local
export CGO_ENABLED=1
BUILD_STAMP="$(git show -s --format=%cI HEAD)"
go build -tags=gtk_3_10 \
    -ldflags "-X main.Version=${WIIMPLAY_REF} -X main.Build=${BUILD_STAMP}" \
    -o wiimplay .
strip wiimplay
test -x wiimplay || { echo "E: [wiimplay] no binary produced"; exit 1; }

echo "I: [wiimplay] installing binary + system launcher"
install -D -m 0755 wiimplay /usr/bin/wiimplay
install -d /usr/share/applications
cat > /usr/share/applications/wiimplay.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=WiiM Play
GenericName=Music Streamer Controller
Comment=UPnP control point for WiiM music streamers
Exec=/usr/bin/wiimplay
Icon=multimedia-audio-player
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
Keywords=wiim;upnp;dlna;music;audio;streamer;
EOF

echo "I: [wiimplay] installing audio HDMI<->Bluetooth notes"
install -d /usr/share/doc/wiim-play
cat > /usr/share/doc/wiim-play/audio-output.md <<'EOF'
# Audio output: switching HDMI <-> Bluetooth

This image uses PipeWire + WirePlumber (pactl still works via the
pipewire-pulse shim). Bluetooth comes up automatically at boot.

## Fidelity ceiling - read this first
- HDMI out = full resolution up to the sink's caps (e.g. 192 kHz / 24-bit to a
  capable AVR or display). Use HDMI for hi-res / mastering work.
- Bluetooth out maxes at 24-bit / 96 kHz, and only with LDAC. Other codecs are
  lower (aptX-HD 24/48; aptX / AAC / SBC lower still). PipeWire resamples
  anything higher down to fit. Bluetooth is for convenience, not a hi-fi master.
- A WiiM streamer plays hi-res from the network, not over this machine's
  Bluetooth. WiiM Play just controls it; the 24/96 ceiling only applies to
  routing this machine's own audio out to a BT speaker/headphone.

## Switch output - GUI
Settings -> Sound -> Output Device -> choose HDMI or the paired BT device.

## Switch output - terminal
  wpctl status                       # list sinks and IDs
  wpctl set-default <ID>             # set HDMI or Bluetooth as default
  pactl list short sink-inputs       # move already-playing streams:
  pactl move-sink-input <input#> <sink-name>
  pactl list short sinks             # sink names (alsa HDMI vs bluez_output.*)

## Pair Bluetooth
Settings -> Bluetooth, or bluetoothctl (scan on; pair; trust; connect <MAC>).

## Confirm the Bluetooth codec (LDAC / 24-96)
  pw-dump | grep -iE "codec|api.bluez5"
Or install pavucontrol and set the device profile/codec under Configuration.

HDMI for fidelity (192k OK) - Bluetooth for convenience (<=24/96 LDAC) -
WiiM for hi-res network streaming (control via WiiM Play).
EOF

echo "I: [wiimplay] purging build dependencies"
apt-get purge -y golang-go libgtk-3-dev pkg-config build-essential
apt-get autoremove -y --purge
apt-get clean

cd /
rm -rf "${BUILD_DIR}" /root/go /root/.cache/go-build 2>/dev/null || true
echo "I: [wiimplay] done — /usr/bin/wiimplay + launcher installed"
